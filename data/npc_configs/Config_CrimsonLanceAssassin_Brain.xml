<BHVBrainSetup xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <m_fsmType>CHR_CrimsonLanceAssassin</m_fsmType>
  <m_BHVPropertySettingsList>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsMeleeAttack">
      <m_attackMode>NAM_MeleeAttack</m_attackMode>
      <m_attackChanceWeight>1</m_attackChanceWeight>
      <m_meleeAttackDistanceMin>0.2</m_meleeAttackDistanceMin>
      <m_meleeAttackDistanceMax>3.5</m_meleeAttackDistanceMax>
      <m_meleeAttackAngle>120</m_meleeAttackAngle>
      <m_meleeAttackIdleTime>0</m_meleeAttackIdleTime>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsBasic">
      <m_healthPoint>200</m_healthPoint>
      <m_shieldPoint>0</m_shieldPoint>
      <m_beenShotAtDuration>20</m_beenShotAtDuration>
      <m_startMoveDistance>2</m_startMoveDistance>
      <m_bHasCoverAbility>true</m_bHasCoverAbility>
      <m_alertCoverChanceWeight>0</m_alertCoverChanceWeight>
      <m_alertMoveToGPPChanceWeight>1</m_alertMoveToGPPChanceWeight>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsThreat">
      <m_distanceFactor>-0.3</m_distanceFactor>
      <m_damageFactor>0.7</m_damageFactor>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsDetection">
      <m_visualDetectionRange>200</m_visualDetectionRange>
      <m_visualDetectionAngle>360</m_visualDetectionAngle>
      <m_auditionDetectionRange>10</m_auditionDetectionRange>
      <m_shootAtAngle>0.9</m_shootAtAngle>
      <m_shootDistance>60</m_shootDistance>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsPatrol">
      <m_patrolRadius>20</m_patrolRadius>
      <m_patrolTime>10</m_patrolTime>
      <m_chanceToIdleWhenReachPatrolPoint>100</m_chanceToIdleWhenReachPatrolPoint>
      <m_stayIdleTimeMin>1</m_stayIdleTimeMin>
      <m_stayIdleTimeMax>4</m_stayIdleTimeMax>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsTimers">
      <m_selectTargetTimer>2</m_selectTargetTimer>
      <m_selectPositionTimer>5</m_selectPositionTimer>
      <m_alertFightTimer>5</m_alertFightTimer>
      <m_alertTimer>12</m_alertTimer>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsCrouchRollDodge">
      <m_changeStanceChanceSafe>0.2</m_changeStanceChanceSafe>
      <m_changeStanceChanceDanger>0.8</m_changeStanceChanceDanger>
      <m_dodgeRepeatTime>5</m_dodgeRepeatTime>
      <m_dodgeChance>0</m_dodgeChance>
      <m_rollChance>0.5</m_rollChance>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsAvoidExplosive">
      <m_dodgeChance>0.6</m_dodgeChance>
      <m_dodgeDistance>3</m_dodgeDistance>
      <m_distanceToExplosive>5</m_distanceToExplosive>
      <m_dodgeRepeatTime>3</m_dodgeRepeatTime>
    </m_BHVPropertySettings>
	<m_BHVPropertySettings xsi:type="BHVFSMSettingsSpacing">
		<m_spacingTime>2</m_spacingTime>
		<m_spacingRangeMin>2</m_spacingRangeMin>
		<m_spacingRangeMax>7</m_spacingRangeMax>
	</m_BHVPropertySettings>
	<m_BHVPropertySettings xsi:type="BHVFSMSettingsInvisible">
		<m_invisibleTimeMax>1.5</m_invisibleTimeMax>
		<m_invisibleTimeMin>1</m_invisibleTimeMin>
	</m_BHVPropertySettings>
	<m_BHVPropertySettings xsi:type="BHVFSMSettingsSwordSlash">
		<m_attackMode>NAM_SwordSlash</m_attackMode>
		<m_attackChanceWeight>1</m_attackChanceWeight>
		<m_swordEnergyDistanceMax>25</m_swordEnergyDistanceMax>
		<m_swordEnergyDistanceMin>5</m_swordEnergyDistanceMin>
		<m_damage>15</m_damage>
	</m_BHVPropertySettings>
	<m_BHVPropertySettings xsi:type="BHVFSMSettingsDefenseField">
		<m_triggleChance>0.4</m_triggleChance>
		<m_bCanKnockBack>true</m_bCanKnockBack>
	</m_BHVPropertySettings>
  </m_BHVPropertySettingsList>
</BHVBrainSetup>













