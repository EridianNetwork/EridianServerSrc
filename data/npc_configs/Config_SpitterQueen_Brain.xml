<BHVBrainSetup xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <m_fsmType>CHR_SpitterQueen</m_fsmType>
  <m_BHVPropertySettingsList>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsPoisonDash">
      <m_attackMode>NAM_PoisonDash</m_attackMode>
      <m_attackChanceWeight>1</m_attackChanceWeight>
      <m_coolDownTime>2</m_coolDownTime>
      <m_triggerAttackDistance>10</m_triggerAttackDistance>
      <m_attackAngle>120</m_attackAngle>
      <m_attackDistance>12</m_attackDistance>
      <m_damagePoint>40</m_damagePoint>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsPoisonSpit">
      <m_attackMode>NAM_PoisonSpit</m_attackMode>
      <m_attackChanceWeight>1</m_attackChanceWeight>
      <m_coolDownTime>2</m_coolDownTime>
      <m_attackDistance>15</m_attackDistance>
      <m_attackAngle>50</m_attackAngle>
      <m_damagePoint>60</m_damagePoint>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsPoisonCrush">
      <m_attackMode>NAM_PoisonCrush</m_attackMode>
      <m_attackChanceWeight>1</m_attackChanceWeight>
      <m_coolDownTime>2</m_coolDownTime>
      <m_attackDistance>11</m_attackDistance>
      <m_damagePoint>75</m_damagePoint>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsBasic">
      <m_healthPoint>8000</m_healthPoint>
      <m_shieldPoint>0</m_shieldPoint>
      <m_beenShotAtDuration>20</m_beenShotAtDuration>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsThreat">
      <m_distanceFactor>-0.5</m_distanceFactor>
      <m_damageFactor>0.5</m_damageFactor>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsDetection">
      <m_visualDetectionRange>13000</m_visualDetectionRange>
      <m_visualDetectionAngle>360</m_visualDetectionAngle>
      <m_auditionDetectionRange>500</m_auditionDetectionRange>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsPatrol">
      <m_patrolRadius>20</m_patrolRadius>
      <m_patrolTime>10</m_patrolTime>
      <m_chanceToIdleWhenReachPatrolPoint>100</m_chanceToIdleWhenReachPatrolPoint>
      <m_stayIdleTimeMin>1</m_stayIdleTimeMin>
      <m_stayIdleTimeMax>2</m_stayIdleTimeMax>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsTimers">
      <m_selectTargetTimer>1</m_selectTargetTimer>
      <m_selectPositionTimer>2</m_selectPositionTimer>
      <m_alertFightTimer>3.5</m_alertFightTimer>
      <m_alertTimer>12</m_alertTimer>
    </m_BHVPropertySettings>
    </m_BHVPropertySettingsList>
	<m_BHVPropertySettingsPhaseList>
    <m_BHVPropertySettingsPhase xsi:type="BHVFSMSettingSpitterQueen">
      <m_phaseId>1</m_phaseId>
      <m_exitPhase_hp>0.66</m_exitPhase_hp>
      <m_poisonDashWeight>1</m_poisonDashWeight>
      <m_poisonSpitWeight>0</m_poisonSpitWeight>
      <m_poisonCrushWeight>0</m_poisonCrushWeight>
      <m_spacingTime>2</m_spacingTime>
    </m_BHVPropertySettingsPhase>
    <m_BHVPropertySettingsPhase xsi:type="BHVFSMSettingSpitterQueen">
      <m_phaseId>2</m_phaseId>
      <m_exitPhase_hp>0.33</m_exitPhase_hp>
      <m_poisonDashWeight>1</m_poisonDashWeight>
      <m_poisonSpitWeight>0</m_poisonSpitWeight>
      <m_poisonCrushWeight>1.2</m_poisonCrushWeight>
      <m_spacingTime>1</m_spacingTime>
    </m_BHVPropertySettingsPhase>
    <m_BHVPropertySettingsPhase xsi:type="BHVFSMSettingSpitterQueen">
      <m_phaseId>3</m_phaseId>
      <m_exitPhase_hp>0</m_exitPhase_hp>
      <m_poisonDashWeight>1</m_poisonDashWeight>
      <m_poisonSpitWeight>1.4</m_poisonSpitWeight>
      <m_poisonCrushWeight>1.2</m_poisonCrushWeight>
      <m_spacingTime>0.5</m_spacingTime>
    </m_BHVPropertySettingsPhase>
	</m_BHVPropertySettingsPhaseList>		
</BHVBrainSetup>
















