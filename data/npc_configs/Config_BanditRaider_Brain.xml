<BHVBrainSetup xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <m_fsmType>CHR_BanditRaider</m_fsmType>
  <m_BHVPropertySettingsList>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsMeleeAttack">
      <m_attackMode>NAM_MeleeAttack</m_attackMode>
      <m_attackChanceWeight>0</m_attackChanceWeight>
      <m_meleeAttackDistanceMin>0.2</m_meleeAttackDistanceMin>
      <m_meleeAttackDistanceMax>2</m_meleeAttackDistanceMax>
      <m_meleeAttackAngle>90</m_meleeAttackAngle>
      <m_meleeAttackIdleTime>0.5</m_meleeAttackIdleTime>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsBasic">
      <m_healthPoint>200</m_healthPoint>
      <m_shieldPoint>0</m_shieldPoint>
      <m_beenShotAtDuration>20</m_beenShotAtDuration>
      <m_startMoveDistance>2</m_startMoveDistance>
      <m_bHasCoverAbility>true</m_bHasCoverAbility>
      <m_alertCoverChanceWeight>1.5</m_alertCoverChanceWeight>
      <m_alertMoveToGPPChanceWeight>1</m_alertMoveToGPPChanceWeight>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsThreat">
      <m_distanceFactor>-0.3</m_distanceFactor>
      <m_damageFactor>0.7</m_damageFactor>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsRangeAttack">
      <m_bestAttackDistanceMax>20</m_bestAttackDistanceMax>
      <m_bestAttackDistanceMin>5</m_bestAttackDistanceMin>
      <m_shootIdleTime>1.5</m_shootIdleTime>
      <m_burstChainedFireLoopCount>4</m_burstChainedFireLoopCount>
      <m_fireRange>60</m_fireRange>
      <IdleSelectPositionTimer>5</IdleSelectPositionTimer>
	  <OpenSpaceMoveDistanceMin>1</OpenSpaceMoveDistanceMin>
	  <OpenSpaceMoveDistanceMax>4</OpenSpaceMoveDistanceMax>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsDetection">
      <m_visualDetectionRange>30</m_visualDetectionRange>
      <m_visualDetectionAngle>360</m_visualDetectionAngle>
      <m_auditionDetectionRange>10</m_auditionDetectionRange>
      <m_shootAtAngle>0.9</m_shootAtAngle>
      <m_shootDistance>60</m_shootDistance>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsPatrol">
      <m_patrolRadius>20</m_patrolRadius>
      <m_patrolTime>10</m_patrolTime>
      <m_chanceToIdleWhenReachPatrolPoint>100</m_chanceToIdleWhenReachPatrolPoint>
      <m_stayIdleTimeMin>1</m_stayIdleTimeMin>
      <m_stayIdleTimeMax>4</m_stayIdleTimeMax>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsTakeCover">
      <m_initialCoverChance>1</m_initialCoverChance>
      <m_dangerCoverChance>1</m_dangerCoverChance>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsTimers">
      <m_selectTargetTimer>0.5</m_selectTargetTimer>
      <m_selectPositionTimer>5</m_selectPositionTimer>
      <m_alertFightTimer>5</m_alertFightTimer>
      <m_alertTimer>12</m_alertTimer>
      <m_selectPositionInCoverTimer>6</m_selectPositionInCoverTimer>
      <m_checkPositionMoveToCoverTimerMin>5</m_checkPositionMoveToCoverTimerMin>
      <m_checkPositionMoveToCoverTimerMax>10</m_checkPositionMoveToCoverTimerMax>
      <m_checkPositionMoveToOpenSpaceTimerMin>5</m_checkPositionMoveToOpenSpaceTimerMin>
      <m_checkPositionMoveToOpenSpaceTimerMax>10</m_checkPositionMoveToOpenSpaceTimerMax>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsCrouchRollDodge">
      <m_dodgeRepeatTime>0</m_dodgeRepeatTime>
      <m_dodgeChance>0</m_dodgeChance>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsAvoidExplosive">
      <m_dodgeChance>0.8</m_dodgeChance>
      <m_dodgeDistance>2.56</m_dodgeDistance>
      <m_distanceToExplosive>5</m_distanceToExplosive>
      <m_dodgeRepeatTime>1</m_dodgeRepeatTime>
    </m_BHVPropertySettings>
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsThrowGrenade">
      <m_throwGrenadeChance>0.4</m_throwGrenadeChance>
    </m_BHVPropertySettings>		
    <m_BHVPropertySettings xsi:type="BHVFSMSettingsCover">
      <m_coverIdleTimeMin>1</m_coverIdleTimeMin>
      <m_coverIdleTimeMax>3</m_coverIdleTimeMax>
      <m_coverIdleCombatSafeTimeMin>1</m_coverIdleCombatSafeTimeMin>
      <m_coverIdleCombatSafeTimeMax>2</m_coverIdleCombatSafeTimeMax>
      <m_coverIdleCombatDangerTimeMin>0.8</m_coverIdleCombatDangerTimeMin>
      <m_coverIdleCombatDangerTimeMax>1.5</m_coverIdleCombatDangerTimeMax>
      <m_coverPeakOutLookAroundTimeMin>4.8</m_coverPeakOutLookAroundTimeMin>
      <m_coverPeakOutLookAroundTimeMax>4.8</m_coverPeakOutLookAroundTimeMax>
      <m_coverPeakOutCombatTimeMin>0</m_coverPeakOutCombatTimeMin>
      <m_coverPeakOutCombatTimeMax>0.1</m_coverPeakOutCombatTimeMax>
      <m_coverFireIdleTimeMin>0.1</m_coverFireIdleTimeMin>
      <m_coverFireIdleTimeMax>0.4</m_coverFireIdleTimeMax>
      <m_leaveCoverDistance>4</m_leaveCoverDistance>
      <m_coverBurstChainedFireLoopCount>10</m_coverBurstChainedFireLoopCount>
    </m_BHVPropertySettings>
  </m_BHVPropertySettingsList>
</BHVBrainSetup>











